# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────────────
# Set this to your real deployed domain (e.g. https://covenant-formation.vercel.app).
# Report-ready and unsubscribe emails build their links from this variable —
# they have no incoming request to fall back to, unlike most routes. Set it on
# every environment (Vercel included) before going live, not just locally.
NEXT_PUBLIC_APP_URL=https://covenant-formation.example.com

# ── Anthropic (AI-personalized report portraits) ───────────────────────────────
# Optional but recommended. Get one from: https://console.anthropic.com
# If left blank, the site still works fully — reports fall back to the
# templated, non-AI portrait text instead of a portrait written from the
# couple's own answers. See docs/VERIFICATION.md.
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional overrides — leave blank to use the built-in defaults
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001

# ── Resend (transactional email: report-ready, unsubscribe) ───────────────────
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=formation@your-domain.com
RESEND_FROM_NAME=Covenant Formation

# ── Internal API secret ─────────────────────────────────────────────────────────
# Used to authorize the internal server-to-server call from
# lib/report/generate.ts to /api/emails/report-ready after a report is
# generated. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── NOT USED IN THIS v1 BUILD (see docs/VERIFICATION.md for the full scope note) ──
# Payments/subscriptions (Paystack, Flutterwave, PayPal), Cloudflare R2 report
# storage, and the cron-based retry sweep are all deliberately out of scope
# for this build and have no code referencing them — nothing to configure.
